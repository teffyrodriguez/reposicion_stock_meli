# Copiar a .env y completar. .env no se commitea.

REDIS_HOST=10.10.200.143
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0
REDIS_TIMEOUT=2.5
REDIS_DEDUP_TTL=1800

# sqlsrv:Server=localhost,1433;Database=Contabilium;TrustServerCertificate=true
DB_DSN=10.10.200.144
DB_USER=ContaDev
DB_PASSWORD=contabilium_dev

PRODUCER_BATCH_SIZE=5000
PRODUCER_MAX_QUEUE=20000
PRODUCER_MAX_BATCHES=100
PRODUCER_SOURCE=reconcile

CONSUMER_MAX_MESSAGES=100
CONSUMER_MAX_ATTEMPTS=5
CONSUMER_IDLE_SECONDS=30
CONSUMER_VISIBILITY_TIMEOUT=120

ML_REFRESH_TIMEZONE=America/Argentina/Buenos_Aires
ML_REFRESH_HOUR=0
ML_REFRESH_MINUTE=0
ML_RESERVED_RPM=25
ML_API_BASE=https://api.mercadolibre.com
ML_HTTP_TIMEOUT=20

# 1 = no llama a Mercado Libre. Lee fixtures/meli-replenishment.json en cada mensaje.
ML_MOCK=0
ML_MOCK_FILE=fixtures/meli-replenishment.json

# Ruta del GET. Puede ser relativa o una URL completa.
# Placeholders: {meLiUserProductId} {idUsuario} {idIntegracion}
ML_REPLENISHMENT_PATH=

# Se envía como query param country en el GET de ML_REPLENISHMENT_PATH.
ML_COUNTRY=

# El access token no se configura acá: por cada mensaje se lee
# ParametrosIntegracion.Valor donde IDIntegracion es el del mensaje y Clave = 'AccessToken'.
